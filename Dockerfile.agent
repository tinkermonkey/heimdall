# ============================================================================
# Heimdall Design System — Agent Environment
# ============================================================================
FROM switchyard-orchestrator:latest

USER root

# ============================================================================
# Playwright/Chromium system dependencies + font rendering consistency
# ============================================================================
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libxcursor1 \
        libxrender1 \
        libxcb-shm0 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libcairo2 \
        libcairo-gobject2 \
        libgdk-pixbuf-2.0-0 \
        libgtk-3-0t64 \
        libharfbuzz0b \
        libfontconfig1 \
        libfreetype6 \
        libdbus-glib-1-2 \
        xvfb \
        fonts-liberation \
        fonts-dejavu-core \
        fonts-noto-color-emoji \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libgbm1 \
        libxkbcommon0 \
        libasound2t64 \
        libatspi2.0-0 \
        fontconfig \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Fontconfig: deterministic rendering (no hinting, grayscale AA, 96 DPI)
# Placed in conf.d so the default fonts.conf chain includes it — setting
# FONTCONFIG_FILE to local.conf would bypass font-directory definitions and
# break system font discovery (Liberation, DejaVu, Noto), causing fallback
# rendering inconsistencies.
# ============================================================================
RUN cat > /etc/fonts/conf.d/99-heimdall-rendering.conf << 'FONTEOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="font">
    <edit name="hinting" mode="assign"><bool>false</bool></edit>
    <edit name="autohint" mode="assign"><bool>false</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintnone</const></edit>
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="rgba" mode="assign"><const>none</const></edit>
    <edit name="lcdfilter" mode="assign"><const>lcdnone</const></edit>
    <edit name="embeddedbitmap" mode="assign"><bool>false</bool></edit>
  </match>
  <!-- Pin DPI to 96 for consistent glyph sizing -->
  <match target="pattern">
    <edit name="dpi" mode="assign"><double>96</double></edit>
  </match>
</fontconfig>
FONTEOF

# ============================================================================
# Install project fonts for the dev server to serve via CSS @font-face
# (woff2 is a web format — fontconfig cannot index it, but the fontconfig
#  settings above still govern how Chromium rasterizes the glyphs)
# ============================================================================
COPY public/fonts /usr/share/fonts/heimdall

# Rebuild font cache so system fonts (Liberation, DejaVu, Noto) are indexed
RUN fc-cache -f

# ============================================================================
# Pre-install project dependencies
# ============================================================================
WORKDIR /workspace/heimdall

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    npm ci --ignore-scripts

# ============================================================================
# Install Playwright Chromium browser
# ============================================================================
RUN PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    npx playwright install chromium

# ============================================================================
# Fix ownership of pre-installed node_modules and browser cache
# ============================================================================
RUN chown -R orchestrator:orchestrator /workspace/heimdall/node_modules && \
    chmod -R a+r /opt/playwright-browsers

# ============================================================================
# Runtime environment
# ============================================================================
ENV CI=true
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ============================================================================
# Switch to runtime user
# ============================================================================
USER orchestrator

# ============================================================================
# Verification
# ============================================================================
RUN claude --version && \
    git --version && \
    gh --version && \
    node -e "require('d3-hierarchy')" && \
    test -f /usr/share/fonts/heimdall/inter/Inter-Regular.woff2 && \
    test -f /usr/share/fonts/heimdall/jetbrains-mono/JetBrainsMono-Regular.woff2 && \
    fc-list | grep -qi "liberation" && \
    fc-list | grep -qi "dejavu"

CMD ["/bin/bash"]
